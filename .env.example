# Environment Configuration for APAAR Connect
ENVIRONMENT=development
PROJECT_NAME="APAAR Connect"
VERSION=1.0.0

# Database Configuration (PostgreSQL for Docker, SQLite fallback for fast local dev)
DATABASE_URL=postgresql://aicte_user:aicte_password_secure@localhost:5432/apaar_connect
POSTGRES_USER=aicte_user
POSTGRES_PASSWORD=aicte_password_secure
POSTGRES_DB=apaar_connect

# Security Keys (Rule 10)
SECRET_KEY=aicte_apaar_connect_super_secret_jwt_key_2025_x99
APAAR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APAAR_KEYED_HASH_SALT=aicte_blind_index_salt_keyed_hmac_sha256_v1
CREDENTIAL_SIGNING_KEY=aicte_credential_signing_secret_key_ed25519_or_hmac_2025

# Rules & Verification Engine
MOCK_APAAR_LABEL=MOCK_APAAR_V1
SYNTHETIC_DATA_BANNER="Synthetic data. Simulated APAAR service."
DEFAULT_RULE_VERSION=AICTE_APPROVAL_HANDBOOK_2024_25_V1
